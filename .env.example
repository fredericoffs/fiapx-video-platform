# Copie para .env e ajuste se necessário. Valores abaixo == defaults do docker-compose.yml.

# Postgres (compartilhado pelo host; cada serviço usa seu próprio schema — ver ADR-008)
DB_NAME=fiapx
DB_USER=fiapx
DB_PASSWORD=fiapx
DB_PORT=5432

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible — ver ADR-004)
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_RAW=videos-raw
STORAGE_BUCKET_PROCESSED=videos-processed

# Mailhog (SMTP local — troca por Amazon SES em produção, ver emenda ao ADR-C3)
SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# JWT (video-api) — NUNCA use este valor em produção
JWT_SECRET=change-me-in-production-min-32-chars-please
JWT_EXPIRATION_MINUTES=30
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# video-gateway — ver ADR-009
GATEWAY_RATE_LIMIT_CAPACITY=20
GATEWAY_RATE_LIMIT_PERIOD_SECONDS=60
GATEWAY_CORS_ALLOWED_ORIGINS=*
