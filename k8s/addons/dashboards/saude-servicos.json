{
  "title": "FIAP X — Saúde dos serviços",
  "uid": "fiapx-saude-servicos",
  "description": "Estado dos pods (kube-state-metrics) e o que cada serviço Spring expõe em /actuator/prometheus: tráfego, latência, erros, JVM, pool do banco e logs de erro.",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "fiapx"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Pods prontos por serviço",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment) (kube_deployment_status_replicas_available{namespace=\"fiapx\"})",
          "legendFormat": "{{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "Reinícios de container (última hora)",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (increase(kube_pod_container_status_restarts_total{namespace=\"fiapx\"}[1h]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Qualquer valor acima de 0 merece olhar: OOMKill, falha de probe ou crash.",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "timeseries",
      "title": "Requisições por segundo",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Latência p95 (video-api e video-gateway)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Upload inclui o recebimento do arquivo: latências de segundos em POST /videos são esperadas."
    },
    {
      "type": "timeseries",
      "title": "Respostas 4xx e 5xx por serviço",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, status) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\", status=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "429 no video-gateway é o rate limit funcionando; 5xx é erro de verdade."
    },
    {
      "type": "timeseries",
      "title": "Erros e avisos no log (por minuto)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, level) (rate(logback_events_total{level=~\"error|warn\"}[$__rate_interval])) * 60",
          "legendFormat": "{{job}} {{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Para ver as linhas: dashboard Logs da aplicação, filtrando o serviço."
    },
    {
      "type": "timeseries",
      "title": "Heap da JVM em uso",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "CPU do processo",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "max by (job) (process_cpu_usage)",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Fração da CPU visível ao processo; no video-worker sobe durante o ffmpeg."
    },
    {
      "type": "timeseries",
      "title": "Tempo em pausa de GC (por segundo)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(jvm_gc_pause_seconds_sum[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Pool de conexões do banco (Hikari)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (hikaricp_connections_active)",
          "legendFormat": "{{job}} ativas"
        },
        {
          "refId": "B",
          "expr": "sum by (job) (hikaricp_connections_pending)",
          "legendFormat": "{{job}} esperando"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Conexões esperando > 0 de forma sustentada indica o pool no limite."
    },
    {
      "type": "timeseries",
      "title": "Memória dos containers",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": null,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"fiapx\", container!=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "description": "Working set medido pelo kubelet (o que conta para OOMKill)."
    }
  ]
}