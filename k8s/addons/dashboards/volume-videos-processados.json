{
  "title": "FIAP X — Volume diário de vídeos processados",
  "uid": "fiapx-volume-diario",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "30s",
  "tags": ["fiapx"],
  "panels": [
    {
      "id": 1,
      "title": "Vídeos processados por dia, por status",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status) (increase(fiapx_video_processed_total[1d]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total processado (COMPLETED)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(fiapx_video_processed_total{status=\"COMPLETED\"})",
          "legendFormat": "COMPLETED",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total com falha (FAILED)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(fiapx_video_processed_total{status=\"FAILED\"})",
          "legendFormat": "FAILED",
          "refId": "A"
        }
      ]
    }
  ]
}
