{
  "title": "FIAP X — Tempo até o resultado",
  "uid": "fiapx-duracao-processamento",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "fiapx"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Tempo médio até o resultado por status · janela móvel de 5 min",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "noValue": "Sem dados"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(fiapx_video_processing_duration_seconds_sum[5m])) / sum by (status) (rate(fiapx_video_processing_duration_seconds_count[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "description": "Inclui espera na fila; não mede apenas CPU/ffmpeg. Sem conclusões na janela, a média não é definida."
    },
    {
      "id": 2,
      "title": "Tempo médio até COMPLETED · período selecionado",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(fiapx_video_processing_duration_seconds_sum{status=\"COMPLETED\"}[$__range])) / sum(increase(fiapx_video_processing_duration_seconds_count{status=\"COMPLETED\"}[$__range]))",
          "legendFormat": "COMPLETED",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Inclui espera na fila; não mede apenas CPU/ffmpeg. Sem conclusões na janela, a média não é definida."
    },
    {
      "id": 3,
      "title": "Tempo médio até FAILED · período selecionado",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(fiapx_video_processing_duration_seconds_sum{status=\"FAILED\"}[$__range])) / sum(increase(fiapx_video_processing_duration_seconds_count{status=\"FAILED\"}[$__range]))",
          "legendFormat": "FAILED",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Inclui espera na fila; não mede apenas CPU/ffmpeg. Sem conclusões na janela, a média não é definida."
    }
  ],
  "description": "Da criação do vídeo até a aplicação do resultado: inclui fila, extração, storage e transporte de eventos."
}
