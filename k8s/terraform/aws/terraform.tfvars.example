# Copie para terraform.tfvars (gitignored) só se quiser sobrescrever os defaults de
# variables.tf. Credenciais NÃO entram aqui: o provider lê AWS_ACCESS_KEY_ID e
# AWS_SECRET_ACCESS_KEY do ambiente (ou do perfil do aws CLI). As IAM roles do cluster e
# dos nós são criadas por iam.tf.
aws_region         = "us-east-1"
cluster_name       = "fiapx"
kubernetes_version = "1.36"
node_instance_type = "t3.large"
node_desired_size  = 3
node_min_size      = 1
node_max_size      = 3
