# Copie para terraform.tfvars (gitignored) só se quiser sobrescrever os defaults de
# variables.tf. Credenciais NÃO entram aqui: o provider lê AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY e AWS_SESSION_TOKEN do ambiente (Learner Lab > AWS Details).
aws_region         = "us-east-1"
cluster_name       = "fiapx"
kubernetes_version = "1.31"
cluster_role_name  = "LabEksClusterRole"
node_role_name     = "LabEksClusterRole"
node_instance_type = "t3.large"
node_desired_size  = 2
node_min_size      = 1
node_max_size      = 3
